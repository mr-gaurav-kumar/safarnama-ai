# Copy this file to .env and fill in the blanks. Never commit .env.

# --- database ---
# Development default: a local SQLite file. No install, no account, no network.
# Good enough through Phase 1 (auth + trips). Phase 2 needs pgvector, which
# SQLite does not have -- switch to the Supabase line below at that point.
DATABASE_URL=sqlite:///./travelplanner.db

# Supabase Session Pooler (port 5432) -- IPv4 compatible, pgvector available.
# Dashboard > Connect > Session pooler. Keep the +psycopg in the scheme.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- background jobs ---
# inline = no Redis needed, jobs run inside the API (use this locally)
# celery = jobs run in a Celery worker via Redis (start.bat then opens a worker
#          and a beat window too)
TASK_BACKEND=inline

# --- cache / broker (only used when TASK_BACKEND=celery) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=30
# Staying logged in across reloads. Defaults suit local development; for a
# deployed HTTPS site set REFRESH_COOKIE_SECURE=true.
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_SECURE=false

# --- LLM + embeddings (Phase 2) ---
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- external APIs (Phase 3 / 8) ---
OPENWEATHER_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
DATA_GOV_API_KEY=

# --- live train search (optional) ---
# Free key: rapidapi.com -> search "IRCTC" (irctc1) -> Subscribe to the Basic (free) plan.
RAPIDAPI_KEY=

# --- email ---
# Leave SMTP_HOST empty and emails print in the backend window instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-character App Password, NOT your Gmail password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# The ONE admin account: only this address, once verified, can be admin.
# Escalated support chats are emailed here too (defaults to SMTP_USER).
ADMIN_EMAIL=

# --- cors / links ---
FRONTEND_URL=http://localhost:5173

# --- Sign in with Google (free) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Authorised JavaScript origins: http://localhost:5173 and http://localhost
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# --- My documents (encrypted ID storage) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP A BACKUP: if this key is lost, saved documents can never be opened again.
DOCUMENT_ENCRYPTION_KEY=

# Only for moving local data into Postgres: python -m app.cli move-to-postgres
SUPABASE_DATABASE_URL=
